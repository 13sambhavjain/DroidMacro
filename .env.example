# Copy to .env at the repo root and fill in what you need. .env is git-ignored.
# A shell export wins over this file. See SETUP.md.

# Needed only to run the baseline agent.
GROQ_API_KEY=
# Optional, for the azure provider in flowagent/llm.py.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Machine settings. Uncomment only if yours differ from these defaults.
# ANDROID_HOME=~/Library/Android/sdk
# ANDROID_CONSOLE_PORT=5554
# ANDROID_GRPC_PORT=8554
# ANDROID_AVD=AndroidWorldAvd
# ANDROID_WORLD_LAUNCH_TIMEOUT=45
