.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Experiment OUTPUT. The traces and recorded flows are KEPT in git: they took
# hours of unattended emulator time, they are the input to every replay
# condition, and they are only ~256KB. Losing them means re-running the baseline.
runs/*.log
runs/nohup*.out
runs/_smoke*
